# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_secret_string_here
WEBHOOK_BASE_URL=https://your-service-name.onrender.com

# Cloudflare MCP Server Portal & Access Service Token
CLOUDFLARE_MCP_PORTAL_URL=https://your-portal.example.com/mcp
CF_ACCESS_CLIENT_ID=your_cloudflare_access_client_id.access
CF_ACCESS_CLIENT_SECRET=your_cloudflare_access_client_secret

# Optional MCP overrides
CF_MCP_TOOL_NAME=generate_lesson_plan
CF_MCP_MODEL=

# Server Port (Render / Docker default: 3000)
PORT=3000

# Admin & Credit System
ADMIN_ID=your_telegram_numeric_user_id_here
ADMIN_USERNAME=your_telegram_username_without_at
DEFAULT_USER_CREDITS=5
DB_PATH=aitadz_bot.db
